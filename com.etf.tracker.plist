<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.etf.tracker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>dist/index.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>$HOME/projects/etf-investment-tracker</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$HOME/projects/etf-investment-tracker/logs/out.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/projects/etf-investment-tracker/logs/err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>NODE_ENV</key>
        <string>production</string>
        <key>PORT</key>
        <string>$PORT</string>
        <key>OAUTH_SERVER_URL</key>
        <string>http://localhost:$PORT</string>
        <key>VITE_OAUTH_PORTAL_URL</key>
        <string>http://localhost:$PORT</string>
        <key>VITE_FRONTEND_FORGE_API_URL</key>
        <string>http://localhost:$PORT</string>
        <key>BUILT_IN_FORGE_API_URL</key>
        <string>http://localhost:$PORT</string>
        <key>VITE_ANALYTICS_ENDPOINT</key>
        <string>http://localhost:$PORT</string>
    </dict>
</dict>
</plist>
